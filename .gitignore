# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code (로컬 설정 및 작업용 worktree)
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# 회원 데이터 엑셀 (설문 응답에 연락처·계좌번호 등 개인정보가 포함됨)
*.xlsx
*.xls
*.csv

# 명찰 자산 (scripts/build-name-badge-assets.mjs가 predev/prebuild에서 생성)
/public/admin/name-badge/template.pdf
/public/admin/name-badge/fonts/Pretendard-Bold.ttf
